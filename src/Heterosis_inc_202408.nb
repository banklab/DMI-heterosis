            And[$CellContext`p == {0, 0}, $CellContext`pA <= 
             1.0000001, $CellContext`pB <= 
             1.0000001], {$CellContext`pA, $CellContext`pB}, 
            NonNegativeReals], All, All, 2]]; $CellContext`eigenvs = 
        Map[Eigenvalues[
           $CellContext`Jacp[{$CellContext`\[Alpha]$$, \
$CellContext`\[Beta]$$, {$CellContext`\[Gamma]$$/
              2, $CellContext`\[Gamma]$$, $CellContext`\[Gamma]$$, 
              2 $CellContext`\[Gamma]$$}, $CellContext`LE, {$CellContext`m$$, \
$CellContext`m$$}}][{$CellContext`pA -> Part[#, 1], $CellContext`pB -> 
             Part[#, 2]}]]& , $CellContext`ze]; $CellContext`stableeq = 
        Quiet[
          Map[If[
            And[Part[#, 1] < 0, Part[#, 2] < 0], 1, 
            0]& , $CellContext`eigenvs]]; $CellContext`zeros = Quiet[
          Map[Join[
            Part[$CellContext`ze, #], {
             Part[$CellContext`stableeq, #]}]& , 
           Range[
            Length[$CellContext`ze]]]]; $CellContext`styleddata = 
        MapApply[Style[#, 
           Part[{
             RGBColor[245/255, 151/255, 45/255, 1], 
             RGBColor[100/255, 100/255, 100/255, 1]}, 
            Mod[#2, 2, 1]]]& , 
          Transpose[{$CellContext`ze, $CellContext`stableeq}]]; Show[
         Legended[
          
          StreamPlot[$CellContext`p, {$CellContext`pA, 0, 
            1}, {$CellContext`pB, 0, 1}, StreamStyle -> {LightGray, 
             Opacity[0.5]}, StreamStyle -> LightGray, StreamColorFunction -> 
