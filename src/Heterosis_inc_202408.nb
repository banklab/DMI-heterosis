             RowBox[{"{", 
              RowBox[{"pA", ",", "pB", ",", "ld"}], "}"}], "]"}], "\[Equal]", 
            
            RowBox[{"{", 
             RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], " ", "&&", " ", 
           RowBox[{"1", ">=", 
            RowBox[{"{", 
             RowBox[{"pA", ",", " ", "pB"}], "}"}], ">=", "0"}], " ", "&&", 
           " ", 
           RowBox[{"pA", "==", "pB"}], " ", "&&", " ", 
           RowBox[{
            RowBox[{"Abs", "[", "ld", "]"}], "<=", "0.25"}]}], ",", 
