          RowBox[{"2", " ", "\[CapitalGamma]"}]}], "}"}], ",", "LE", ",", 
        RowBox[{"{", 
         RowBox[{"mig", ",", "mig"}], "}"}]}], "}"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
