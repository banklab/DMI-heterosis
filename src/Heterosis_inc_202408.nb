             RGBColor[100/255, 100/255, 100/255, 1]}, {
             Style["Stable", 26, Black], 
             Style["Unstable", 26, Black]}, LegendMarkerSize -> 30, 
            LegendLayout -> "Row", LegendLabel -> 
            Style["Stability of equilibrium", 26, Black]], Top]], 
