    "0", ",", "0.00001", ",", " ", "0.0001", ",", " ", "0.001", ",", " ", 
     "0.01", ",", " ", "0.1", ",", " ", "0.5"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"j", "=", "1"}], ",", 
   RowBox[{"j", "<=", 
