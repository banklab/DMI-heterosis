Cell[BoxData[{
 RowBox[{
  RowBox[{"paramsvec", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"0.02", ",", "0.02", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"0.045", "/", "2"}], ",", "0.045", ",", "0.045", ",", 
       RowBox[{"2", " ", "0.045"}]}], "}"}], ",", 
     RowBox[{"10", "^", 
      RowBox[{"-", "1.25"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"0.00001", ",", "0.00001"}], "}"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p", "=", 
   RowBox[{
    RowBox[{"pdots", "[", "paramsvec", "]"}], "[", 
    RowBox[{"{", 
     RowBox[{"pA", ",", "pB", ",", "ld"}], "}"}], "]"}]}], ";", 
  RowBox[{"ze", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"NSolve", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"p", "==", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], " ", "&&", " ", 
        RowBox[{"0", "<=", "pA", "<=", "1.0000001"}], "&&", 
        RowBox[{"0", "<=", "pB", "<=", "1.0000001"}], " ", "&&", " ", 
        RowBox[{"0.25", ">=", "ld", ">=", 
         RowBox[{"-", "0.25"}]}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"pA", ",", "pB", ",", "ld"}], "}"}], ",", " ", "Reals"}], 
      "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "All", ",", "2"}], "]"}], "]"}], "//", "Quiet"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ze", " ", "=", " ", 
   RowBox[{"DeleteDuplicates", "[", 
    RowBox[{"ze", ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"#1", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "-", 
          RowBox[{"#2", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "+", 
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"#1", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "-", 
          RowBox[{"#2", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "+", 
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"#1", "[", 
           RowBox[{"[", "3", "]"}], "]"}], "-", 
          RowBox[{"#2", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}], "]"}]}], "<", "0.00001"}], " ", 
      "&"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eigenvs", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Eigenvalues", "[", 
      RowBox[{
       RowBox[{"Jacp", "[", "paramsvec", "]"}], "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"pA", "->", 
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
         RowBox[{"pB", "->", 
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], ",", 
         RowBox[{"ld", " ", "->", 
          RowBox[{"#", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}]}], "}"}], "]"}], "]"}], " ", 
     "&"}], " ", "/@", " ", "ze"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"stableeq", " ", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "<", "0"}], "&&", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "<", "0"}], "&&", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "3", "]"}], "]"}], "<", "0"}]}], ",", "1", ",", "0"}],
        "]"}], "  ", "&"}], " ", "/@", "eigenvs"}], "//", "Quiet"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"zeros", " ", "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"ze", "[", 
        RowBox[{"[", "#", "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"stableeq", "[", 
         RowBox[{"[", "#", "]"}], "]"}], "}"}]}], "]"}], " ", "&"}], "  ", "/@",
     " ", 
    RowBox[{"Range", "[", 
     RowBox[{"Length", "[", "ze", "]"}], "]"}]}], "//", 
   "Quiet"}]}], "\[IndentingNewLine]"}], "Input",
