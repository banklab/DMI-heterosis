           "Reals"}], " ", "&&", " ", 
          RowBox[{"\[Gamma]", ">=", "0"}], " ", "&&", " ", 
          RowBox[{"\[Alpha]", ">=", "0"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"\[Alpha]", ",", "\[Gamma]"}], "}"}], ",", " ", "Reals"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"isreal", "!=", "False"}], ",", ",", ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"ei", " ", "=", " ", 
          RowBox[{
           RowBox[{"Eigenvalues", "[", 
            RowBox[{
             RowBox[{"Jacx", "[", 
              RowBox[{"{", 
               RowBox[{
               "\[Alpha]", ",", "\[Alpha]", ",", "\[CapitalGamma]x", ",", "r",
                 ",", "M"}], "}"}], "]"}], "[", 
             RowBox[{"sols", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], " ", "//", " ", 
           "Simplify"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
            "Check", " ", "if", " ", "eigenvalue", " ", "is", " ", "stable"}],
             ",", " ", 
            RowBox[{
             RowBox[{"i", ".", "e", ".", " ", "real"}], " ", "and", " ", 
             "negative"}]}], ")"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"isstable", " ", "=", 
          RowBox[{
           RowBox[{"Reduce", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"ei", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "<", "0"}], " ", "&&", " ", 
              RowBox[{
               RowBox[{"ei", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "<", "0"}], " ", "&&", " ", 
              RowBox[{"\[Alpha]", ">=", "0"}], "&&", 
              RowBox[{"\[Beta]", ">=", "0"}], " ", "&&", " ", 
              RowBox[{"\[Gamma]", ">=", "0"}], " ", "&&", " ", 
              RowBox[{"r", ">=", "0"}]}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"\[Alpha]", ",", "\[Beta]"}], "}"}], ",", " ", 
             "Reals"}], " ", "]"}], " ", "//", " ", "Simplify"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"isstable", "==", "False"}], ",", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{"Print", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"solsLE", "[", 
                RowBox[{"[", "i", "]"}], "]"}], " ", "//", " ", "Simplify"}], 
