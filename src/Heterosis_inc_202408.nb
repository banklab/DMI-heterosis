             RowBox[{"alleletohaplo", "[", "#", "]"}], "]"}]}], "&"}]}], 
         "]"}]}]}]}], " ", 
     RowBox[{"(*", 
      RowBox[{"Get", " ", "only", " ", "positive", " ", "values"}], "*)"}], 
