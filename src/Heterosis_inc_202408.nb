           ",", " ", 
           RowBox[{
            RowBox[{"i", ".", "e", ".", " ", "real"}], " ", "and", " ", 
            "negative"}]}], ")"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"isstable", " ", "=", 
         RowBox[{
          RowBox[{"Reduce", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"ei", "<", 
              RowBox[{"{", 
               RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], " ", "&&", " ", 
