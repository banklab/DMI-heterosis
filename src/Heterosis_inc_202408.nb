                RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
              RowBox[{"pB", "->", 
               RowBox[{"#", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], ",", " ", 
            RowBox[{"ld", "->", "ld"}]}], "]"}], "]"}], " ", "&"}], " ", "/@",
         " ", "ze"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"stableeq", " ", "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "<", "0"}], "&&", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "<", "0"}]}], ",", "1", ",", 
            "0"}], "]"}], "  ", "&"}], " ", "/@", "eigenvs"}], "//", 
        "Quiet"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"zeros", " ", "=", 
