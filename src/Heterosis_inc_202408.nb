Cell[BoxData[{
 RowBox[{
  RowBox[{"allsolutionsLErec", " ", "=", " ", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"\[CapitalGamma]", " ", "=", " ", "0"}], ",", " ", 
   RowBox[{"\[CapitalGamma]", "<=", 
    RowBox[{"5", " ", "\[CapitalAlpha]"}]}], ",", " ", 
   RowBox[{"\[CapitalGamma]", " ", "=", " ", 
    RowBox[{"\[CapitalGamma]", " ", "+", "0.0001"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"stableeq", " ", "=", " ", 
     RowBox[{"PolyEqs", "[", 
      RowBox[{"{", 
       RowBox[{"\[CapitalAlpha]", ",", "\[CapitalBeta]", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[CapitalGamma]", "/", "2"}], ",", "\[CapitalGamma]", ",", 
          "\[CapitalGamma]", ",", 
          RowBox[{"2", " ", "\[CapitalGamma]"}]}], "}"}], ",", "LE", ",", 
        RowBox[{"{", 
         RowBox[{"mig", ",", "mig"}], "}"}]}], "}"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", "stableeq", "]"}], ">", "0"}], ",", 
      RowBox[{
       RowBox[{"AppendTo", "[", 
        RowBox[{"allsolutionsLErec", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[CapitalGamma]", "/", "\[CapitalAlpha]"}], ",", " ", 
           "100", ",", "stableeq"}], "}"}]}], "]"}], ";"}], ",", "False"}], 
     "]"}]}]}], "\[IndentingNewLine]", "]"}], "\n"}], "Input",
