Cell[TextData[{
 "Let the haplotype frequencies of ab, aB, Ab, and AB be described by the \
vector ",
 StyleBox["x",
  FontWeight->"Bold"],
 " = {x1, x2, x3, x4}.  And ",
 StyleBox["\[AliasDelimiter] ",
  FontWeight->"Bold"],
 "the linkage disequilibrium given by ",
 StyleBox["D",
  FontWeight->"Bold"],
 " = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["x", "1"], 
     SubscriptBox["x", "4"]}], "-", " ", 
    RowBox[{
     SubscriptBox["x", "2"], 
     SubscriptBox["x", "3"]}]}], TraditionalForm]],ExpressionUUID->
  "8ebe92c0-650b-414b-a17c-280f9bdaf403"],
 " "
}], "Text",
