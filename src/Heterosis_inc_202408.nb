Cell[BoxData[
 RowBox[{
  RowBox[{"anasolplot", " ", "=", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         FractionBox["m", "\[Alpha]"], "+", 
         FractionBox[
          RowBox[{
           RowBox[{"8", " ", 
            SuperscriptBox["\[Alpha]", "2"]}], "-", 
           RowBox[{"2", " ", "\[Alpha]", " ", "\[Gamma]"}]}], 
          RowBox[{
           RowBox[{"16", " ", 
            SuperscriptBox["\[Alpha]", "2"]}], "-", 
           SuperscriptBox["\[Gamma]", "2"]}]]}], " ", "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[Alpha]", "->", " ", "0.05"}], ",", 
          RowBox[{"\[Beta]", "->", "0.05"}], ",", 
          RowBox[{"\[Gamma]", "->", "0.1"}]}], "}"}]}], ",", 
       RowBox[{
        RowBox[{
         FractionBox["\[Alpha]", 
          RowBox[{" ", 
           RowBox[{
            RowBox[{"2", "\[Alpha]"}], "+", "\[Gamma]"}]}]], "+", 
         FractionBox[
          RowBox[{
           RowBox[{"\[Gamma]", "/", "\[Alpha]"}], " ", "m"}], 
          RowBox[{"(", 
