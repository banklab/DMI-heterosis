Cell[BoxData[{
 RowBox[{
  RowBox[{"allsolutionsLErec", " ", "=", " ", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"\[CapitalGamma]", " ", "=", " ", "0"}], ",", " ", 
   RowBox[{"\[CapitalGamma]", "<=", 
    RowBox[{"5", " ", "\[CapitalAlpha]"}]}], ",", " ", 
   RowBox[{"\[CapitalGamma]", " ", "=", " ", 
