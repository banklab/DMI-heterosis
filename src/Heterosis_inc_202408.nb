Cell[BoxData[
 RowBox[{
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"Evaluate", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"-", 
          FractionBox[
           RowBox[{"4", " ", "r", " ", "\[Alpha]", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"2", " ", "\[Alpha]"}], "+", "\[Gamma]"}], ")"}]}], 
           RowBox[{"\[Gamma]", " ", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{
               RowBox[{"4", " ", "\[Alpha]"}], "+", "\[Gamma]"}], ")"}], 
             "2"]}]]}], "+", 
         FractionBox[
          RowBox[{"2", " ", "\[Alpha]"}], 
          RowBox[{
           RowBox[{"4", " ", "\[Alpha]"}], "+", "\[Gamma]"}]]}], " ", "/.", 
        RowBox[{"\[Alpha]", "->", "0.02"}]}], ",", 
       RowBox[{"{", 
