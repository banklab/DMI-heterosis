                RowBox[{"migration", "[", 
                 RowBox[{"[", "m", "]"}], "]"}], ",", "stableeq"}], "}"}]}], 
             "]"}], ";"}], ",", "False"}], "]"}], ";", "\[IndentingNewLine]", 
         
         RowBox[{"AppendTo", "[", 
