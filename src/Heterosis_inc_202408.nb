1f8bfedb98d7"],

Cell[TextData[{
 StyleBox["If ",
  Background->RGBColor[
   0.6190280003051805, 0.6813153276874953, 0.9990386816205081]],
 StyleBox["C",
  FontWeight->"Bold",
  Background->RGBColor[
   0.6190280003051805, 0.6813153276874953, 0.9990386816205081]],
 StyleBox[" is neutral, maybe I need to write this in terms of the initial \
frequency of ",
  Background->RGBColor[
   0.6190280003051805, 0.6813153276874953, 0.9990386816205081]],
 StyleBox["C",
  FontWeight->"Bold",
  Background->RGBColor[
   0.6190280003051805, 0.6813153276874953, 0.9990386816205081]],
 StyleBox[", unless it\[CloseCurlyQuote]s tightly linked to ",
  Background->RGBColor[
   0.6190280003051805, 0.6813153276874953, 0.9990386816205081]],
 StyleBox["B",
  FontWeight->"Bold",
  Background->RGBColor[
   0.6190280003051805, 0.6813153276874953, 0.9990386816205081]],
 StyleBox[". In that case, the increase in its fitness in the island will be \
slow  r << 0.5. ",
  Background->RGBColor[
   0.6190280003051805, 0.6813153276874953, 0.9990386816205081]]
}], "Text",
 CellChangeTimes->{{3.938144062199964*^9, 3.938144255177328*^9}, 
   3.940048028305963*^9},ExpressionUUID->"a8ffa141-5ae1-4758-aaa3-\
1636f8adc245"],

Cell["\<\
Let' s see this formula by setting different parameters to \[Alpha], \[Beta], \
\[Gamma] and r\
\>", "Text",
 CellChangeTimes->{{3.9381442701073427`*^9, 3.938144319405264*^9}, 
   3.9400476520483437`*^9},ExpressionUUID->"91204d9a-aa76-4ddf-9631-\
61d272b4783a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"sneut", "[", 
    RowBox[{"wh_", ",", "wb_", ",", "r_", ",", "t_"}], "]"}], " ", ":=", " ", 
   
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", "r"}], ")"}], "^", "t"}], " ", "wh"}], " ", "+", 
     " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", "r"}], ")"}], "^", "t"}]}], ")"}], " ", "wb"}]}], 
    ")"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.938144322490203*^9, 3.938144501142358*^9}, {
   3.9381448834605093`*^9, 3.938144921683956*^9}, {3.938144993440722*^9, 
   3.9381450261391783`*^9}, 3.938145935843667*^9, 3.938145990509647*^9, 
   3.94004804740549*^9},
 CellLabel->
  "In[216]:=",ExpressionUUID->"d2aa6a5f-b403-40e9-bfcd-3b2dbb5c1f80"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"sneut", "[", 
       RowBox[{"1", ",", "0.25", ",", 
        RowBox[{"1", "*", 
         RowBox[{"(", 
          RowBox[{"10", "^", 
           RowBox[{"-", "r"}]}], ")"}]}], ",", "t"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"r", ",", 
        RowBox[{"{", 
         RowBox[{
         "0.0001", ",", "0.001", ",", "0.01", ",", "0.1", ",", "0.5"}], 
         "}"}]}], "}"}]}], "]"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "50"}], "}"}], ",", 
   RowBox[{"PlotRange", "->", "Full"}], ",", " ", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"{", 
     RowBox[{"0.0001", ",", "0.001", ",", "0.01", ",", "0.1", ",", "0.5"}], 
     "}"}]}]}], "]"}]], "Input",
