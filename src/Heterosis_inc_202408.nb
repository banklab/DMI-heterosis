Cell[BoxData[{
 RowBox[{
  RowBox[{"paramsvec", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"0.02", ",", "0.02", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"0.045", "/", "2"}], ",", "0.045", ",", "0.045", ",", 
