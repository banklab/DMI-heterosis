            RowBox[{"Scaled", "[", "0.04", "]"}]}]}], "]"}], ",", " ", 
         RowBox[{"Placed", "[", 
          RowBox[{
           RowBox[{"PointLegend", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"RGBColor", "[", 
