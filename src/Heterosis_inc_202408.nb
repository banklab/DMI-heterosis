Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"plotgroup", " ", "=", 
   RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"p", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"pdots", "[", 
          RowBox[{"{", 
           RowBox[{"\[Alpha]", ",", "\[Beta]", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"\[Gamma]", "/", "2"}], ",", "\[Gamma]", ",", 
              "\[Gamma]", ",", 
              RowBox[{"2", "\[Gamma]"}]}], "}"}], ",", "LE", ",", 
            RowBox[{"{", 
             RowBox[{"m", ",", "m"}], "}"}]}], "}"}], "]"}], "[", 
         RowBox[{"{", 
          RowBox[{"pA", ",", "pB", ",", "0"}], "}"}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"1", ";;", "2"}], "]"}], "]"}]}], ";", 
      RowBox[{"ze", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"NSolve", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"p", "==", 
