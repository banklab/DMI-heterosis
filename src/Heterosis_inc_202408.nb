          "Reals"}], " ", "&&", " ", 
         RowBox[{"\[Gamma]", ">=", "0"}], " ", "&&", " ", 
         RowBox[{"\[Alpha]", ">=", "0"}]}], ",", " ", 
        RowBox[{"{", 
