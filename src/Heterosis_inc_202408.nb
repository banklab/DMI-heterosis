Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"plotgroup", " ", "=", 
  RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"p", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"pdots", "[", 
         RowBox[{"{", 
          RowBox[{"\[Alpha]", ",", "\[Beta]", ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "\[Gamma]", ",", "\[Gamma]", ",", 
             RowBox[{"2", "\[Gamma]"}]}], "}"}], ",", "LE", ",", 
           RowBox[{"{", 
            RowBox[{"m", ",", "m"}], "}"}]}], "}"}], "]"}], "[", 
        RowBox[{"{", 
         RowBox[{"pA", ",", "pB", ",", "0"}], "}"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"1", ";;", "2"}], "]"}], "]"}]}], ";", 
     RowBox[{"ze", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"NSolve", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"p", "==", 
            RowBox[{"{", 
             RowBox[{"0", ",", "0"}], "}"}]}], " ", "&&", " ", 
           RowBox[{"pA", "<=", "1.0000001"}], "&&", 
           RowBox[{"pB", "<=", "1.0000001"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"pA", ",", "pB"}], "}"}], ",", " ", "NonNegativeReals"}], 
         "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "All", ",", "2"}], "]"}], "]"}], "//", 
       "Quiet"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"eigenvs", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Eigenvalues", "[", 
         RowBox[{
          RowBox[{"Jacp", "[", 
           RowBox[{"{", 
            RowBox[{"\[Alpha]", ",", "\[Beta]", ",", 
             RowBox[{"{", 
              RowBox[{"0", ",", "\[Gamma]", ",", "\[Gamma]", ",", 
               RowBox[{"2", "\[Gamma]"}]}], "}"}], ",", "LE", ",", 
             RowBox[{"{", 
              RowBox[{"m", ",", "m"}], "}"}]}], "}"}], "]"}], "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"pA", "->", 
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
            RowBox[{"pB", "->", 
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], "]"}], "]"}], " ", 
        "&"}], " ", "/@", " ", "ze"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"stableeq", " ", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "<", "0"}], "&&", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "<", "0"}]}], ",", "1", ",", 
           "0"}], "]"}], "  ", "&"}], " ", "/@", "eigenvs"}], "//", 
       "Quiet"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"zeros", " ", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"ze", "[", 
            RowBox[{"[", "#", "]"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"stableeq", "[", 
             RowBox[{"[", "#", "]"}], "]"}], "}"}]}], "]"}], " ", "&"}], "  ",
         "/@", " ", 
        RowBox[{"Range", "[", 
         RowBox[{"Length", "[", "ze", "]"}], "]"}]}], "//", "Quiet"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"styleddata", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{"#", ",", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"RGBColor", "[", 
              RowBox[{
               RowBox[{"245", "/", "255"}], ",", 
               RowBox[{"151", "/", "255"}], ",", 
               RowBox[{"45", "/", "255"}], ",", "1"}], "]"}], ",", 
             RowBox[{"RGBColor", "[", 
              RowBox[{
               RowBox[{"100", "/", "255"}], ",", 
               RowBox[{"100", "/", "255"}], ",", 
               RowBox[{"100", "/", "255"}], ",", "1"}], "]"}]}], "}"}], "[", 
           RowBox[{"[", 
            RowBox[{"Mod", "[", 
             RowBox[{"#2", ",", "2", ",", "1"}], "]"}], "]"}], "]"}]}], "]"}],
         "&"}], "@@@", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"ze", ",", "stableeq"}], "}"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Show", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Legended", "[", 
        RowBox[{
         RowBox[{"StreamPlot", "[", 
          RowBox[{"p", ",", 
           RowBox[{"{", 
            RowBox[{"pA", ",", "0", ",", "1"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"pB", ",", "0", ",", "1"}], "}"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"StreamStyle", "->", 
            RowBox[{"{", 
             RowBox[{"LightGray", ",", 
              RowBox[{"Opacity", "[", "0.5", "]"}]}], "}"}]}], ",", " ", 
           "\[IndentingNewLine]", 
           RowBox[{"StreamStyle", "->", "LightGray"}], ",", " ", 
           "\[IndentingNewLine]", 
           RowBox[{"StreamColorFunction", "\[Rule]", "\"\<GrayTones\>\""}], 
           ",", " ", "\[IndentingNewLine]", 
