8c4a817285ad"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"allpoints", " ", "=", " ", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"startx", "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0.01", ",", "0.5"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"startx2", "=", 
   RowBox[{"Join", "[", 
    RowBox[{"startx", ",", 
     RowBox[{"{", 
      RowBox[{"1", "-", 
       RowBox[{"Total", "[", "startx", "]"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"allp", " ", "=", " ", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"i", "=", "0"}], ",", 
   RowBox[{"i", "<", "5500"}], ",", 
   RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"startx", "=", 
      RowBox[{"startx", "+", 
       RowBox[{
        RowBox[{
         RowBox[{"xdots", "[", "2", "]"}], "[", 
         RowBox[{"{", 
          RowBox[{"\[Alpha]", ",", "\[Beta]", ",", 
           RowBox[{"{", 
            RowBox[{
            "\[Gamma]1", ",", "\[Gamma]2", ",", "\[Gamma]3", ",", 
             "\[Gamma]4"}], "}"}], ",", "r", ",", 
           RowBox[{"{", 
            RowBox[{"m1", ",", "m2", ",", " ", "m"}], "}"}]}], "}"}], "]"}], 
        "[", "startx", "]"}]}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"i", "==", "400"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"ran", " ", "=", " ", "0"}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"startx", "[", 
          RowBox[{"[", "1", "]"}], "]"}], " ", "=", " ", 
         RowBox[{
          RowBox[{"startx", "[", 
           RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", "ran"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"startx", "[", 
          RowBox[{"[", "2", "]"}], "]"}], " ", "=", " ", 
         RowBox[{
          RowBox[{"startx", "[", 
           RowBox[{"[", "2", "]"}], "]"}], " ", "+", " ", 
          RowBox[{"ran", "/", "2"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"startx", "[", 
          RowBox[{"[", "3", "]"}], "]"}], " ", "=", " ", 
         RowBox[{
          RowBox[{"startx", "[", 
           RowBox[{"[", "3", "]"}], "]"}], " ", "+", " ", 
          RowBox[{"ran", "/", "2"}]}]}], ";"}]}], "\[IndentingNewLine]", 
      "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"g", " ", "=", " ", "0.5"}], ";", "\[IndentingNewLine]", 
    RowBox[{"startx", "=", 
     RowBox[{"startx", "+", 
      RowBox[{
       RowBox[{"xdots", "[", 
        RowBox[{"{", 
         RowBox[{"0.1", ",", "0.1", ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "g", ",", "g", ",", 
            RowBox[{"2", " ", "g"}]}], "}"}], ",", "0.5", ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "0"}], "}"}]}], "}"}], "]"}], "[", "startx", 
       "]"}]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"startx2", "=", 
     RowBox[{"Join", "[", 
      RowBox[{"startx", ",", 
       RowBox[{"{", 
        RowBox[{"1", "-", 
         RowBox[{"Total", "[", "startx", "]"}]}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"AppendTo", "[", 
     RowBox[{"allpoints", ",", " ", "startx2"}], "]"}], ";"}]}], 
  "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"Transpose", "[", "allpoints", "]"}], ",", " ", 
