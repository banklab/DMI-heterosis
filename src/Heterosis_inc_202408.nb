               RowBox[{"Reduce", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"1", ">=", 
                   RowBox[{
                    RowBox[{"sols", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", "2"}], "]"}], "]"}], ">=", "0"}], " ",
                   "&&", 
                  RowBox[{"\[Beta]", ">=", "0"}], " ", "&&", 
                  RowBox[{"\[Alpha]", ">=", "0"}], "&&", 
                  RowBox[{"\[Gamma]", ">=", "0"}], " ", "&&", " ", 
