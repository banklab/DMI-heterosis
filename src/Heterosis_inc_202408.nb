Cell[BoxData[
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"i", "=", "1"}], ",", 
   RowBox[{"i", "<=", 
    RowBox[{"Length", "[", "solution", "]"}]}], ",", 
   RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ei", " ", "=", " ", 
     RowBox[{
      RowBox[{"Eigenvalues", "[", 
       RowBox[{
        RowBox[{"Jacx", "[", 
         RowBox[{"{", 
          RowBox[{
          "\[Alpha]", ",", "\[Beta]", ",", "\[CapitalGamma]x", ",", "r", ",", 
           "M"}], "}"}], "]"}], "[", 
        RowBox[{"solution", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], " ", "//", " ", 
      "Simplify"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
       "Check", " ", "if", " ", "eigenvalue", " ", "is", " ", "stable"}], ",",
        " ", 
       RowBox[{
        RowBox[{"i", ".", "e", ".", " ", "real"}], " ", "and", " ", 
        "negative"}]}], ")"}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"Print", "[", "ei", "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{"isstable", " ", "=", 
     RowBox[{
      RowBox[{"Reduce", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"ei", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "<", "0"}], " ", "&&", " ", 
         RowBox[{
          RowBox[{"ei", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "<", "0"}], " ", "&&", 
         RowBox[{
          RowBox[{"ei", "[", 
           RowBox[{"[", "3", "]"}], "]"}], "<", "0"}], " ", "&&", " ", 
         RowBox[{"r", ">=", "0"}], "&&", 
         RowBox[{"\[Alpha]", ">=", "0"}], "&&", 
         RowBox[{"\[Beta]", ">=", "0"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"r", ",", "\[Alpha]"}], "}"}], ",", " ", "Reals"}], " ", 
       "]"}], " ", "//", " ", "Simplify"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"isstable", "==", "False"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{
         RowBox[{"solution", "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", "\"\<\\t Unstable\>\""}], 
        "]"}], ";"}], ",", 
      RowBox[{"Print", "[", "0", "]"}], ",", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{
         RowBox[{"solution", "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", "\"\<\\t Stable\>\""}], "]"}], 
       ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
