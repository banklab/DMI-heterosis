Cell[BoxData[{
 RowBox[{
  RowBox[{"allsolutionsrecessive", " ", "=", " ", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"numsolrecessive", " ", "=", " ", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"For", " ", "[", 
  RowBox[{
   RowBox[{"m", "=", "1"}], ",", " ", 
   RowBox[{"m", "<=", 
    RowBox[{"Length", "[", "migration", "]"}]}], ",", " ", 
   RowBox[{"m", "++"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"migration", "[", 
      RowBox[{"[", "m", "]"}], "]"}], "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"\[CapitalGamma]", " ", "=", " ", "0"}], ",", " ", 
      RowBox[{"\[CapitalGamma]", "<=", 
       RowBox[{"8.5", " ", "\[CapitalAlpha]"}]}], ",", " ", 
      RowBox[{"\[CapitalGamma]", " ", "=", " ", 
       RowBox[{"\[CapitalGamma]", " ", "+", "0.01"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "1"}], ",", " ", 
        RowBox[{"i", "<=", 
         RowBox[{"Length", "[", "reclist", "]"}]}], ",", " ", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"stableeq", " ", "=", " ", 
          RowBox[{"PolyEqs", "[", 
           RowBox[{"{", 
            RowBox[{"\[CapitalAlpha]", ",", "\[CapitalBeta]", ",", 
             RowBox[{"{", 
              RowBox[{
              "0", ",", "\[CapitalGamma]", ",", "\[CapitalGamma]", ",", 
               RowBox[{"2", " ", "\[CapitalGamma]"}]}], "}"}], ",", 
             RowBox[{"reclist", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"migration", "[", 
                RowBox[{"[", "m", "]"}], "]"}], ",", 
               RowBox[{"migration", "[", 
                RowBox[{"[", "m", "]"}], "]"}]}], "}"}]}], "}"}], "]"}]}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "stableeq", "]"}], ">", "0"}], ",", 
           RowBox[{
            RowBox[{"AppendTo", "[", 
             RowBox[{"allsolutionsrecessive", ",", 
              RowBox[{"{", 
               RowBox[{
