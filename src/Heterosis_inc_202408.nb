Cell["For recessive DMIs", "Text",
 CellChangeTimes->{{3.929523410138049*^9, 
  3.929523421085744*^9}},ExpressionUUID->"678bd634-b3dc-4445-ae54-\
acd7ebcc5cca"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"plotgroup", " ", "=", 
  RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"p", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"pdots", "[", 
         RowBox[{"{", 
          RowBox[{"\[Alpha]", ",", "\[Beta]", ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "\[Gamma]", ",", "\[Gamma]", ",", 
             RowBox[{"2", "\[Gamma]"}]}], "}"}], ",", "LE", ",", 
           RowBox[{"{", 
            RowBox[{"m", ",", "m"}], "}"}]}], "}"}], "]"}], "[", 
        RowBox[{"{", 
         RowBox[{"pA", ",", "pB", ",", "0"}], "}"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"1", ";;", "2"}], "]"}], "]"}]}], ";", 
     RowBox[{"ze", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"NSolve", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"p", "==", 
            RowBox[{"{", 
             RowBox[{"0", ",", "0"}], "}"}]}], " ", "&&", " ", 
           RowBox[{"pA", "<=", "1.0000001"}], "&&", 
           RowBox[{"pB", "<=", "1.0000001"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"pA", ",", "pB"}], "}"}], ",", " ", "NonNegativeReals"}], 
         "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "All", ",", "2"}], "]"}], "]"}], "//", 
       "Quiet"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"eigenvs", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Eigenvalues", "[", 
         RowBox[{
          RowBox[{"Jacp", "[", 
           RowBox[{"{", 
            RowBox[{"\[Alpha]", ",", "\[Beta]", ",", 
             RowBox[{"{", 
              RowBox[{"0", ",", "\[Gamma]", ",", "\[Gamma]", ",", 
               RowBox[{"2", "\[Gamma]"}]}], "}"}], ",", "LE", ",", 
             RowBox[{"{", 
              RowBox[{"m", ",", "m"}], "}"}]}], "}"}], "]"}], "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"pA", "->", 
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
            RowBox[{"pB", "->", 
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], "]"}], "]"}], " ", 
        "&"}], " ", "/@", " ", "ze"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"stableeq", " ", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "<", "0"}], "&&", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "<", "0"}]}], ",", "1", ",", 
           "0"}], "]"}], "  ", "&"}], " ", "/@", "eigenvs"}], "//", 
       "Quiet"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"zeros", " ", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"ze", "[", 
            RowBox[{"[", "#", "]"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"stableeq", "[", 
             RowBox[{"[", "#", "]"}], "]"}], "}"}]}], "]"}], " ", "&"}], "  ",
         "/@", " ", 
        RowBox[{"Range", "[", 
         RowBox[{"Length", "[", "ze", "]"}], "]"}]}], "//", "Quiet"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"styleddata", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{"#", ",", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"RGBColor", "[", 
              RowBox[{
               RowBox[{"245", "/", "255"}], ",", 
               RowBox[{"151", "/", "255"}], ",", 
               RowBox[{"45", "/", "255"}], ",", "1"}], "]"}], ",", 
             RowBox[{"RGBColor", "[", 
              RowBox[{
               RowBox[{"100", "/", "255"}], ",", 
               RowBox[{"100", "/", "255"}], ",", 
               RowBox[{"100", "/", "255"}], ",", "1"}], "]"}]}], "}"}], "[", 
           RowBox[{"[", 
            RowBox[{"Mod", "[", 
             RowBox[{"#2", ",", "2", ",", "1"}], "]"}], "]"}], "]"}]}], "]"}],
         "&"}], "@@@", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"ze", ",", "stableeq"}], "}"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Show", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Legended", "[", 
        RowBox[{
         RowBox[{"StreamPlot", "[", 
          RowBox[{"p", ",", 
           RowBox[{"{", 
            RowBox[{"pA", ",", "0", ",", "1"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"pB", ",", "0", ",", "1"}], "}"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"StreamStyle", "->", 
            RowBox[{"{", 
             RowBox[{"LightGray", ",", 
              RowBox[{"Opacity", "[", "0.5", "]"}]}], "}"}]}], ",", " ", 
           "\[IndentingNewLine]", 
           RowBox[{"StreamStyle", "->", "LightGray"}], ",", " ", 
           "\[IndentingNewLine]", 
           RowBox[{"StreamColorFunction", "\[Rule]", "\"\<GrayTones\>\""}], 
           ",", " ", "\[IndentingNewLine]", 
           RowBox[{"StreamColorFunctionScaling", "->", "False"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"StreamPoints", "->", "Coarse"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"Frame", "->", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"True", ",", "True"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"True", ",", "True"}], "}"}]}], "}"}]}], ",", 
           RowBox[{"FrameLabel", "->", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Style", "[", 
                 RowBox[{
                 "\"\<Freq. of A (\!\(\*SubscriptBox[\(p\), \(A\)]\))\>\"", 
                  ",", "22", ",", " ", "Black"}], "]"}], ",", "None"}], "}"}],
               ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Style", "[", 
                 RowBox[{
                 "\"\<Freq. of B (\!\(\*SubscriptBox[\(p\), \(B\)]\))\>\"", 
                  ",", "22", ",", " ", "Black"}], "]"}], ",", "None"}], 
               "}"}]}], "}"}]}], ",", 
           RowBox[{"FrameTicks", "\[Rule]", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"0", ",", "0.5", ",", "1"}], "}"}], ",", "None"}], 
               "}"}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"0", ",", "0.5", ",", "1"}], "}"}], ",", "None"}], 
               "}"}]}], "}"}]}], ",", " ", 
           RowBox[{"FrameStyle", "->", 
            RowBox[{"Directive", "[", 
             RowBox[{"Black", ",", " ", "18"}], "]"}]}], ",", 
           "\[IndentingNewLine]", "\t", 
           RowBox[{"AspectRatio", "->", "1"}], ",", " ", 
           "\[IndentingNewLine]", "\t", 
           RowBox[{"ImageSize", "->", 
            RowBox[{"{", 
             RowBox[{"500", ",", "500"}], "}"}]}], ",", "\[IndentingNewLine]",
            "\t", 
           RowBox[{"PlotLabel", "->", 
            RowBox[{"Style", "[", 
             RowBox[{
             "\"\<Very strong DMIs (\[Gamma] = 0.13)\>\"", ",", "23", ",", 
              " ", "Black"}], "]"}]}], ",", " ", 
           RowBox[{"PlotRangePadding", "->", 
            RowBox[{"Scaled", "[", "0.04", "]"}]}]}], "]"}], ",", " ", 
         RowBox[{"Placed", "[", 
          RowBox[{
           RowBox[{"PointLegend", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"RGBColor", "[", 
                RowBox[{
                 RowBox[{"245", "/", "255"}], ",", 
                 RowBox[{"151", "/", "255"}], ",", 
                 RowBox[{"45", "/", "255"}], ",", "1"}], "]"}], ",", 
               RowBox[{"RGBColor", "[", 
                RowBox[{
                 RowBox[{"100", "/", "255"}], ",", 
                 RowBox[{"100", "/", "255"}], ",", 
                 RowBox[{"100", "/", "255"}], ",", "1"}], "]"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{"\"\<Stable\>\"", ",", "24", ",", " ", "Black"}], 
                "]"}], ",", " ", 
               RowBox[{"Style", "[", 
                RowBox[{"\"\<Unstable\>\"", ",", "24", ",", " ", "Black"}], 
                "]"}]}], "}"}], ",", " ", 
             RowBox[{"LegendMarkerSize", "->", "30"}], ",", 
             RowBox[{"LegendLayout", "->", "\"\<Row\>\""}], ",", 
             RowBox[{"LegendLabel", "->", 
              RowBox[{"Style", "[", 
               RowBox[{
               "\"\<Stability of equilibrium (Recessive DMIs)\>\"", ",", "24",
                 ",", "Black"}], "]"}]}]}], "]"}], ",", " ", "Top"}], "]"}]}],
         " ", "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"ListPlot", "[", 
        RowBox[{"styleddata", ",", " ", 
         RowBox[{"BaseStyle", "->", 
          RowBox[{"PointSize", "[", "0.035", "]"}]}]}], "]"}]}], 
      "\[IndentingNewLine]", "\t", 
      RowBox[{"(*", 
       RowBox[{",", 
        RowBox[{"PlotRange", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "0.01"}], ",", "1.03"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "0.01"}], ",", "1.0"}], "}"}]}], "}"}]}]}], "*)"}], 
      
      RowBox[{"(*", 
       RowBox[{",", " ", 
        RowBox[{"AxesOrigin", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "0.02"}], ",", 
           RowBox[{"-", "0.02"}]}], "}"}]}]}], "*)"}], "]"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Alpha]", ",", "0.2"}], "}"}], ",", 
      RowBox[{"-", "0.2"}], ",", "1", ",", "0.01", ",", " ", 
      RowBox[{"Appearance", "->", " ", "\"\<Labeled\>\""}]}], "}"}], ",", 
    "\[IndentingNewLine]", " ", 
