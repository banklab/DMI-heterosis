Cell[BoxData[
 RowBox[{
  RowBox[{"anasolplot", " ", "=", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         FractionBox["m", "\[Alpha]"], "+", 
         FractionBox[
          RowBox[{
           RowBox[{"8", " ", 
            SuperscriptBox["\[Alpha]", "2"]}], "-", 
           RowBox[{"2", " ", "\[Alpha]", " ", "\[Gamma]"}]}], 
          RowBox[{
           RowBox[{"16", " ", 
            SuperscriptBox["\[Alpha]", "2"]}], "-", 
           SuperscriptBox["\[Gamma]", "2"]}]]}], " ", "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[Alpha]", "->", " ", "0.05"}], ",", 
          RowBox[{"\[Beta]", "->", "0.05"}], ",", 
          RowBox[{"\[Gamma]", "->", "0.1"}]}], "}"}]}], ",", 
       RowBox[{
        RowBox[{
         FractionBox["\[Beta]", 
          RowBox[{
           RowBox[{"2", " ", "\[Beta]"}], "+", "\[Gamma]"}]], "-", 
         FractionBox[
          RowBox[{
           RowBox[{"2", " ", "m"}], "+", 
           FractionBox[
            SuperscriptBox["\[Beta]", "2"], 
            RowBox[{
             RowBox[{"2", " ", "\[Beta]"}], "+", "\[Gamma]"}]], "+", 
           FractionBox[
            RowBox[{"\[Beta]", " ", "\[Gamma]"}], 
            RowBox[{
             RowBox[{"2", " ", "\[Beta]"}], "+", "\[Gamma]"}]], "-", 
           SqrtBox[
            RowBox[{
             FractionBox[
              RowBox[{"4", " ", "m", " ", 
               SuperscriptBox["\[Gamma]", "2"]}], 
              RowBox[{
               RowBox[{"2", " ", "\[Beta]"}], "+", "\[Gamma]"}]], "+", 
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"-", "2"}], " ", "m"}], "-", 
                FractionBox[
                 SuperscriptBox["\[Beta]", "2"], 
                 RowBox[{
                  RowBox[{"2", " ", "\[Beta]"}], "+", "\[Gamma]"}]], "-", 
                FractionBox[
                 RowBox[{"\[Beta]", " ", "\[Gamma]"}], 
                 RowBox[{
                  RowBox[{"2", " ", "\[Beta]"}], "+", "\[Gamma]"}]]}], ")"}], 
              "2"]}]]}], 
          RowBox[{"2", " ", "\[Gamma]"}]]}], " ", "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[Alpha]", "->", " ", "0.05"}], ",", 
          RowBox[{"\[Beta]", "->", "0.05"}], ",", 
          RowBox[{"\[Gamma]", "->", "0.1"}]}], "}"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"m", ",", "0", ",", "0.02"}], "}"}], ",", " ", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"LineLegend", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "\"\<Tight linkage (r=0)\>\"", ",", " ", 
          "\"\<Linkage equilibrium\>\""}], "}"}], ",", " ", 
        RowBox[{"LegendLabel", "->", "\"\<Analytical approx.\>\""}]}], 
       "]"}]}], ",", " ", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<m\>\"", ",", " ", "\"\<pA\>\""}], "}"}]}], ",", 
