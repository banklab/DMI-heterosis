Cell["Test for stability", "Text",
 CellChangeTimes->{{3.917602681816799*^9, 3.9176026955699663`*^9}, {
  3.9176680950064096`*^9, 
  3.917668095227128*^9}},ExpressionUUID->"4e345780-42f4-44dc-bb2b-\
28f3ed1b174d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"i", "=", "1"}], ",", 
    RowBox[{"i", "<=", 
     RowBox[{"Length", "[", "solHap", "]"}]}], ",", 
    RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"isreal", " ", "=", " ", 
      RowBox[{"Reduce", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"solHap", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "2"}], "]"}], "]"}], " ", "\[Element]", " ", 
          "Reals"}], "&&", " ", 
         RowBox[{"\[Gamma]", ">=", "0"}], " ", "&&", " ", 
         RowBox[{"\[Alpha]", ">=", "0"}], " ", "&&", " ", 
         RowBox[{"\[Beta]", ">=", "0"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"\[Alpha]", ",", "\[Gamma]", ",", "\[Beta]"}], "}"}], ",", 
        " ", "Reals"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"isreal", "!=", "False"}], ",", ",", ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"ei", " ", "=", " ", 
         RowBox[{
          RowBox[{"Eigenvalues", "[", 
           RowBox[{
            RowBox[{"Jacx", "[", 
             RowBox[{"{", 
              RowBox[{
              "\[Alpha]", ",", "\[Beta]", ",", "\[CapitalGamma]x", ",", "0", 
               ",", "M"}], "}"}], "]"}], "[", 
            RowBox[{"solHap", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], " ", "//", " ", 
          "Simplify"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
           "Check", " ", "if", " ", "eigenvalue", " ", "is", " ", "stable"}], 
           ",", " ", 
           RowBox[{
            RowBox[{"i", ".", "e", ".", " ", "real"}], " ", "and", " ", 
            "negative"}]}], ")"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"isstable", " ", "=", 
         RowBox[{
          RowBox[{"Reduce", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"ei", "<", 
              RowBox[{"{", 
               RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], " ", "&&", " ", 
             RowBox[{"\[Alpha]", ">=", "0"}], "&&", 
             RowBox[{"\[Beta]", ">=", "0"}], " ", "&&", " ", 
             RowBox[{"\[Gamma]", ">=", "0"}], " ", "&&", " ", 
             RowBox[{"1", ">=", 
              RowBox[{
               RowBox[{"solHap", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", "2"}], "]"}], "]"}], ">=", "0"}]}], ",", 
            " ", 
            RowBox[{"{", 
             RowBox[{"\[Alpha]", ",", "\[Beta]"}], "}"}], ",", " ", "Reals"}],
            " ", "]"}], " ", "//", " ", "Simplify"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"isstable", "==", "False"}], ",", "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"solHap", "[", 
              RowBox[{"[", "i", "]"}], "]"}], " ", "//", " ", "Simplify"}], 
            ",", "\"\<\\t Unstable\>\""}], "]"}], ",", 
          RowBox[{"Print", "[", "0", "]"}], ",", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{
             RowBox[{"solHap", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", "\"\<\\t Stable (i=\>\"", 
             ",", "i", ",", "\"\<) \\n\>\"", ",", 
             RowBox[{"Style", "[", 
              RowBox[{
               RowBox[{"Reduce", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"1", ">=", 
                   RowBox[{
                    RowBox[{"solHap", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", "2"}], "]"}], "]"}], ">=", "0"}], " ",
                   "&&", 
                  RowBox[{"\[Beta]", ">=", "0"}], " ", "&&", 
                  RowBox[{"\[Alpha]", ">=", "0"}], "&&", 
                  RowBox[{"\[Gamma]", ">=", "0"}], " ", "&&", " ", 
                  RowBox[{"ei", "<", 
                   RowBox[{"{", 
                    RowBox[{"0", ",", "0", ",", "0"}], "}"}]}]}], ",", " ", 
                 RowBox[{"{", 
                  RowBox[{"\[Alpha]", ",", "\[Gamma]"}], "}"}], ",", 
                 "Reals"}], "]"}], ",", "Bold"}], "]"}]}], "]"}], ";"}]}], 
         "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
     ";"}]}], "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]"}]], "Input",\

