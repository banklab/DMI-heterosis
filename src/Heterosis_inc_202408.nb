Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "Stability", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"i", "=", "1"}], ",", 
    RowBox[{"i", "<=", 
     RowBox[{"Length", "[", "sols", "]"}]}], ",", 
    RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"isreal", " ", "=", " ", 
      RowBox[{"Reduce", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"sols", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "2"}], "]"}], "]"}], " ", "\[Element]", " ", 
          "Reals"}], "&&", " ", 
         RowBox[{"\[Gamma]", ">=", "0"}], " ", "&&", " ", 
         RowBox[{"\[Alpha]", ">=", "0"}], " ", "&&", " ", 
         RowBox[{"\[Beta]", ">=", "0"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"\[Alpha]", ",", "\[Gamma]", ",", "\[Beta]"}], "}"}], ",", 
        " ", "Reals"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"isreal", "!=", "False"}], ",", ",", ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"ei", " ", "=", " ", 
         RowBox[{
          RowBox[{"Eigenvalues", "[", 
           RowBox[{
            RowBox[{"Jacp", "[", 
             RowBox[{"{", 
              RowBox[{
              "\[Alpha]", ",", "\[Beta]", ",", "\[CapitalGamma]x", ",", "r", 
               ",", "M"}], "}"}], "]"}], "[", 
            RowBox[{"sols", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], " ", "//", " ", 
          "Simplify"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
           "Check", " ", "if", " ", "eigenvalue", " ", "is", " ", "stable"}], 
           ",", " ", 
           RowBox[{
            RowBox[{"i", ".", "e", ".", " ", "real"}], " ", "and", " ", 
            "negative"}]}], ")"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"isstable", " ", "=", 
         RowBox[{
          RowBox[{"Reduce", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"ei", "<", 
              RowBox[{"{", 
               RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], " ", "&&", " ", 
             RowBox[{"\[Alpha]", ">=", "0"}], "&&", 
             RowBox[{"\[Beta]", ">=", "0"}], " ", "&&", " ", 
             RowBox[{"\[Gamma]", ">=", "0"}], " ", "&&", " ", 
             RowBox[{"1", ">=", 
              RowBox[{
               RowBox[{"sols", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", "2"}], "]"}], "]"}], ">=", "0"}]}], ",", 
            " ", 
            RowBox[{"{", 
             RowBox[{"\[Alpha]", ",", "\[Beta]"}], "}"}], ",", " ", "Reals"}],
            " ", "]"}], " ", "//", " ", "Simplify"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"isstable", "==", "False"}], ",", "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"sols", "[", 
              RowBox[{"[", "i", "]"}], "]"}], " ", "//", " ", "Simplify"}], 
            ",", "\"\<\\t Unstable\>\""}], "]"}], ",", 
          RowBox[{"Print", "[", "0", "]"}], ",", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{
             RowBox[{"sols", "[", 
