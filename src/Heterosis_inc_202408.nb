          RowBox[{"[", "2", "]"}], "]"}], "-", 
         RowBox[{"x", "[", 
          RowBox[{"[", "3", "]"}], "]"}]}], ")"}]}], "+", 
      RowBox[{"2", "*", 
       RowBox[{"x", "[", 
        RowBox[{"[", "2", "]"}], "]"}], "*", 
       RowBox[{"x", "[", 
        RowBox[{"[", "3", "]"}], "]"}]}]}], ",", 
