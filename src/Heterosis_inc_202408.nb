Cell[BoxData[
 RowBox[{
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        SubsuperscriptBox[
         StyleBox["x", "TI"], "1", "\[Prime]"], "\[LongEqual]", 
        FractionBox[
         RowBox[{
           RowBox[{"(", 
             RowBox[{"1", "-", 
               StyleBox["m", "TI"]}], ")"}], "(", 
           RowBox[{
             SubscriptBox[
              StyleBox["x", "TI"], "1"], 
             SubscriptBox[
              StyleBox["w", "TI"], "1"], "-", 
             StyleBox["r", "TI"], 
             SubscriptBox[
              StyleBox["w", "TI"], "14"], 
             StyleBox["L", "TI"], 
             StyleBox["D", "TI"]}], ")"}], 
         OverscriptBox[
          StyleBox["w", "TI"], "_"]], "\n", 
        SubsuperscriptBox[
         StyleBox["x", "TI"], "2", "\[Prime]"], "\[LongEqual]", 
        FractionBox[
         RowBox[{
           RowBox[{"(", 
             RowBox[{"1", "-", 
               StyleBox["m", "TI"]}], ")"}], "(", 
           RowBox[{
             SubscriptBox[
              StyleBox["x", "TI"], "2"], 
             SubscriptBox[
              StyleBox["w", "TI"], "2"], "+", 
             StyleBox["r", "TI"], 
             SubscriptBox[
              StyleBox["w", "TI"], "14"], 
             StyleBox["L", "TI"], 
             StyleBox["D", "TI"]}], ")"}], 
         OverscriptBox[
          StyleBox["w", "TI"], "_"]], "+", 
        StyleBox["m", "TI"], "2", "\\[NewLine]", 
        SubsuperscriptBox[
         StyleBox["x", "TI"], "3", "\[Prime]"], "\[LongEqual]", 
        FractionBox[
         RowBox[{
           RowBox[{"(", 
             RowBox[{"1", "-", 
               StyleBox["m", "TI"]}], ")"}], "(", 
           RowBox[{
             SubscriptBox[
              StyleBox["x", "TI"], "3"], 
             SubscriptBox[
              StyleBox["w", "TI"], "3"], "+", 
             StyleBox["r", "TI"], 
             SubscriptBox[
              StyleBox["w", "TI"], "14"], 
             StyleBox["L", "TI"], 
             StyleBox["D", "TI"]}], ")"}], 
         OverscriptBox[
          StyleBox["w", "TI"], "_"]], "+", 
        StyleBox["m", "TI"], "3", "\\[NewLine]", 
        SubsuperscriptBox[
         StyleBox["x", "TI"], "4", "\[Prime]"], "\[LongEqual]", 
        FractionBox[
         RowBox[{
           RowBox[{"(", 
             RowBox[{"1", "-", 
               StyleBox["m", "TI"]}], ")"}], "(", 
           RowBox[{
             SubscriptBox[
              StyleBox["x", "TI"], "4"], 
             SubscriptBox[
              StyleBox["w", "TI"], "4"], "-", 
             StyleBox["r", "TI"], 
             SubscriptBox[
              StyleBox["w", "TI"], "14"], 
             StyleBox["L", "TI"], 
             StyleBox["D", "TI"]}], ")"}], 
         OverscriptBox[
          StyleBox["w", "TI"], "_"]]}], TraditionalForm], "errors" -> {}, 
    "input" -> 
    "x_1' = {(1-m)(x_1 w_1 - r w_{14} LD)\\over \\overline{w}} \\\\           \
x_2' = {(1-m)(x_2 w_2 + r w_{14} LD)\\over \\overline{w}} + m2 \\\\      x_3' \
= {(1-m)(x_3 w_3 + r w_{14} LD)\\over \\overline{w}} + m3 \\\\      x_4' = \
{(1-m)(x_4 w_4 - r w_{14} LD)\\over \\overline{w}}", "state" -> "Boxes"|>,
