    RowBox[{"\[CapitalGamma]", " ", "+", "0.0001"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"stableeq", " ", "=", " ", 
     RowBox[{"PolyEqs", "[", 
      RowBox[{"{", 
       RowBox[{"\[CapitalAlpha]", ",", "\[CapitalBeta]", ",", 
        RowBox[{"{", 
