Cell[BoxData[{
 RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "}"}]}], " ", 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"DAB", " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"x", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "*", 
      RowBox[{"x", "[", 
       RowBox[{"[", "4", "]"}], "]"}]}], " ", "-", 
     RowBox[{
      RowBox[{"x", "[", 
       RowBox[{"[", "2", "]"}], "]"}], "*", 
      RowBox[{"x", "[", 
       RowBox[{"[", "3", "]"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"m", " ", "=", " ", 
     RowBox[{"m2", " ", "+", " ", "m3"}]}], ";"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Some", " ", "conversion", " ", "rules", " ", 
    RowBox[{"(", 
     RowBox[{"Haplotype", "->", "Allele"}], ")"}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"transferpRule", " ", "=", " ", 
   RowBox[{
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"pA", "\[Equal]", 
         RowBox[{"1", "-", "x1", "-", "x2"}]}], ",", 
        RowBox[{"pB", "\[Equal]", 
         RowBox[{"1", "-", "x1", "-", "x3"}]}], ",", 
        RowBox[{"ld", "==", 
         RowBox[{
          RowBox[{"x1", "*", 
           RowBox[{"(", 
            RowBox[{"1", "-", "x1", "-", "x2", "-", "x3"}], ")"}]}], "-", 
          RowBox[{"x2", "*", "x3"}]}]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"x1", ",", "x2", ",", "x3"}], "}"}]}], "]"}], "//", 
    "Flatten"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"alleletohaplo", "[", 
    RowBox[{"{", 
     RowBox[{"pA_", ",", "pB_", ",", "LD_"}], "}"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"1", "+", "LD", "-", "pA", "-", "pB", "+", 
       RowBox[{"pA", " ", "pB"}]}], ",", 
      RowBox[{
       RowBox[{"-", "LD"}], "+", "pB", "-", 
       RowBox[{"pA", " ", "pB"}]}], ",", 
      RowBox[{
       RowBox[{"-", "LD"}], "+", "pA", "-", 
       RowBox[{"pA", " ", "pB"}]}]}], "}"}], "//", "Simplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"haplotoallele", "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"1", "-", 
       RowBox[{"x", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "-", 
       RowBox[{"x", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ",", 
      RowBox[{"1", "-", 
       RowBox[{"x", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "-", 
       RowBox[{"x", "[", 
        RowBox[{"[", "3", "]"}], "]"}]}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"x", "[", 
         RowBox[{"[", "1", "]"}], "]"}], 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"x", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "-", 
          RowBox[{"x", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "-", 
          RowBox[{"x", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}], ")"}]}], "-", 
       RowBox[{
        RowBox[{"x", "[", 
         RowBox[{"[", "2", "]"}], "]"}], 
        RowBox[{"x", "[", 
         RowBox[{"[", "3", "]"}], "]"}]}]}]}], "}"}], "//", "Simplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"haplotogeno", "[", "x_", "]"}], ":=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"x", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "*", 
