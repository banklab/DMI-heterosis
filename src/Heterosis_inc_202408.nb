            RowBox[{"m", ",", "m"}], "}"}]}], "}"}], "]"}], "[", 
        RowBox[{"{", 
         RowBox[{"pA", ",", "pB", ",", "ld"}], "}"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ze", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"NSolve", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"p", "==", 
             RowBox[{"{", 
              RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], " ", "&&", " ", 
            RowBox[{"pA", "<=", "1.0000001"}], "&&", 
            RowBox[{"pB", "<=", "1.0000001"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"pA", ",", "pB"}], "}"}], ",", " ", "NonNegativeReals"}], 
          "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "All", ",", "2"}], "]"}], "]"}], "//", 
        "Quiet"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", "ze", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"eigenvs", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Eigenvalues", "[", 
          RowBox[{
           RowBox[{"Jacp", "[", 
            RowBox[{"{", 
             RowBox[{"\[Alpha]", ",", "\[Beta]", ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"\[Gamma]", "/", "2"}], ",", "\[Gamma]", ",", 
                "\[Gamma]", ",", 
                RowBox[{"2", "\[Gamma]"}]}], "}"}], ",", "0", ",", 
              RowBox[{"{", 
               RowBox[{"m", ",", "m"}], "}"}]}], "}"}], "]"}], "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"pA", "->", 
