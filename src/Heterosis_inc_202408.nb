Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Function", " ", "to", " ", "get", " ", "all", " ", "fully", " ", 
    "polymorphic", " ", "stable", " ", "equilibra"}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"PolyEqs", "[", 
     RowBox[{"{", 
      RowBox[{"\[Alpha]_", ",", "\[Beta]_", ",", "G_", ",", "r_", ",", "M_"}],
       "}"}], "]"}], " ", ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "stablepoly", ",", " ", "stableeqs", ",", "p", ",", "ze", ",", 
        "eigenvs", ",", "stableeq"}], "}"}], ",", "\[IndentingNewLine]", "\t", 
      RowBox[{
       RowBox[{"p", "=", 
        RowBox[{
         RowBox[{"pdots", "[", 
          RowBox[{"{", 
           RowBox[{"\[Alpha]", ",", "\[Beta]", ",", "G", ",", "r", ",", "M"}],
            "}"}], "]"}], "[", 
         RowBox[{"{", 
          RowBox[{"pA", ",", "pB", ",", "ld"}], "}"}], "]"}]}], " ", ";", 
       "\[IndentingNewLine]", "\t", 
       RowBox[{"ze", "=", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"NSolve", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"p", "==", 
               RowBox[{"{", 
                RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], " ", "&&", " ", 
              RowBox[{"0", "<=", "pA", "<=", "1.0000001"}], "&&", 
              RowBox[{"0", "<=", "pB", "<=", "1.0000001"}], " ", "&&", " ", 
              RowBox[{
               RowBox[{"Abs", "[", "ld", "]"}], "<=", "0.25"}]}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"pA", ",", "pB", ",", "ld"}], "}"}], ",", " ", 
             "Reals"}], "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "All", ",", "2"}], "]"}], "]"}], "//", 
          "DeleteDuplicates"}], " ", "//", " ", "Quiet"}]}], " ", ";", "\n", 
       "\t", 
       RowBox[{"ze", " ", "=", " ", 
        RowBox[{"DeleteDuplicates", "[", 
         RowBox[{"ze", ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{"#1", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "-", 
               RowBox[{"#2", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "+", 
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{"#1", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "-", 
               RowBox[{"#2", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "+", 
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{"#1", "[", 
                RowBox[{"[", "3", "]"}], "]"}], "-", 
               RowBox[{"#2", "[", 
                RowBox[{"[", "3", "]"}], "]"}]}], "]"}]}], "<", "0.00001"}], 
           " ", "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", "\t", 
       RowBox[{"eigenvs", " ", "=", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"Eigenvalues", "[", 
           RowBox[{
            RowBox[{"Jacp", "[", 
             RowBox[{"{", 
              RowBox[{
              "\[Alpha]", ",", "\[Beta]", ",", "G", ",", "r", ",", "M"}], 
              "}"}], "]"}], "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"pA", "->", 
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
              RowBox[{"pB", "->", 
               RowBox[{"#", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], ",", " ", 
              RowBox[{"ld", "->", 
               RowBox[{"#", "[", 
                RowBox[{"[", "3", "]"}], "]"}]}]}], "}"}], "]"}], "]"}], " ", 
          "&"}], " ", "/@", " ", "ze"}]}], ";", "\[IndentingNewLine]", "\t", 
       RowBox[{"stableeq", " ", "=", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"AllTrue", "[", 
           RowBox[{"#", ",", "Negative"}], "]"}], "&"}], " ", "/@", " ", 
         "eigenvs"}]}], ";", "\[IndentingNewLine]", "\t", 
       RowBox[{"stableeqs", "=", 
        RowBox[{"ze", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"Position", "[", 
            RowBox[{"stableeq", ",", "True"}], "]"}], "//", "Flatten"}], 
          "]"}], "]"}]}], " ", ";", "\[IndentingNewLine]", "\t", 
       RowBox[{"stablepoly", " ", "=", " ", 
        RowBox[{"Select", "[", 
         RowBox[{"stableeqs", ",", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "!=", "0"}], " ", "&&", " ", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "!=", "0"}]}], "&"}]}], 
         "]"}]}]}]}], "\[IndentingNewLine]", "]"}]}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
