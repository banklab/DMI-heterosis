      RowBox[{"mig", " ", "=", " ", 
       RowBox[{"mig", " ", "+", "0.001"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"numsols", " ", "=", " ", 
        RowBox[{"NSolve", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"pdots", "[", 
              RowBox[{"{", 
