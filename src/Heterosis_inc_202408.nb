            " ", "]"}], " ", "//", " ", "Simplify"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"isstable", "==", "False"}], ",", "\[IndentingNewLine]", 
