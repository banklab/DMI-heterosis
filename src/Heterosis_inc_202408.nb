Cell[CellGroupData[{

Cell["Fixation of a neutral allele in the island", "Chapter",
 CellChangeTimes->{{3.938143338524857*^9, 3.938143367193288*^9}, {
   3.938143405064444*^9, 3.938143412695799*^9}, 
   3.938143982490272*^9},ExpressionUUID->"98902f04-e3e0-4d75-aeae-\
e6a834d7cacc"],

Cell[TextData[{
 "Let a third neutral locus ",
 StyleBox["\[ScriptCapitalC]",
  FontWeight->"Bold"],
 " with alleles ",
 StyleBox["c/C",
  FontWeight->"Bold"],
 " be fixed for ",
 StyleBox["C",
  FontWeight->"Bold"],
 " in one continent, and for ",
 StyleBox["c",
  FontWeight->"Bold"],
 " in the other such that continental types are ",
 StyleBox["Abc",
  FontWeight->"Bold"],
 " and ",
 StyleBox["aBC",
  FontWeight->"Bold"],
 " respectively. The selection coefficient for ",
 StyleBox["C ",
  FontWeight->"Bold"],
 "will be: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          OverscriptBox[
           StyleBox["s", "TI"], "_"], 
          RowBox[{
            StyleBox["n", "TI"], ",", 
            StyleBox["h", "TI"]}], 
          RowBox[{"(", 
            StyleBox["t", "TI"], ")"}]], "\[LongEqual]", 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{"1", "-", 
              StyleBox["r", "TI"]}], ")"}], 
          StyleBox["t", "TI"]], 
         SubscriptBox[
          StyleBox["w", "TI"], 
          StyleBox["h", "TI"]], "+", "1", "-", 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{"1", "-", 
              StyleBox["r", "TI"]}], ")"}], 
          StyleBox["t", "TI"]], 
         OverscriptBox[
          StyleBox["w", "TI"], "_"]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\overline{s}_{n,h}^{(t)} = (1-r)^t w_h + 1-(1-r)^t \\overline{w}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "43f96f97-6f68-4dff-b798-678dee1cebc6"],
 " "
}], "Text",
 CellChangeTimes->{{3.9381433823153343`*^9, 3.938143463320879*^9}, {
  3.938143496553804*^9, 3.938143688276772*^9}, {3.938143771728383*^9, 
  3.9381437817628937`*^9}},ExpressionUUID->"bca44d0d-ed57-4b97-a66d-\
39bc3c7aac21"],

Cell[TextData[{
 "If ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["w", "aBC"], TraditionalForm]],ExpressionUUID->
  "19ee61df-d944-4780-8b80-99b53125d879"],
 "= 0, then:"
}], "Text",
 CellChangeTimes->{{3.938143791794711*^9, 3.938143795497224*^9}, {
   3.938143845178256*^9, 3.9381438978422194`*^9}, 3.940303877660408*^9, 
   3.940303924801903*^9},ExpressionUUID->"dec8434c-e53f-465b-9103-\
bd19cebc115c"],

Cell[BoxData[""], "Input",
 CellChangeTimes->{{3.940303882987979*^9, 3.94030388684277*^9}, {
  3.940303918557314*^9, 
  3.940303920834359*^9}},ExpressionUUID->"6a5ca6b3-f99c-4bd3-bae0-\
3ab39f1981ba"],

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          OverscriptBox[
           StyleBox["s", "TI"], "_"], 
          RowBox[{
            StyleBox["n", "TI"], ",", 
            StyleBox["h", "TI"]}], 
          RowBox[{"(", 
            StyleBox["t", "TI"], ")"}]], "\[LongEqual]", "1", "-", 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{"1", "-", 
              StyleBox["r", "TI"]}], ")"}], 
          StyleBox["t", "TI"]], 
         OverscriptBox[
          StyleBox["w", "TI"], "_"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\overline{s}_{n,h}^{(t)} = 1-(1-r)^t \\overline{w}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], " "}], TraditionalForm]], "Text",
 CellChangeTimes->{{3.938143898876*^9, 3.938143910559907*^9}, 
