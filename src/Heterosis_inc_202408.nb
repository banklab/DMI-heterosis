                    RowBox[{"0", ",", "0", ",", "0"}], "}"}]}]}], ",", " ", 
                 RowBox[{"{", 
                  RowBox[{"\[Alpha]", ",", "\[Gamma]"}], "}"}], ",", 
                 "Reals"}], "]"}], ",", "Bold"}], "]"}]}], "]"}], ";"}]}], 
