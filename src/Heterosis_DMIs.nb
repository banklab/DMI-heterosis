             RowBox[{"\[Alpha]", ">=", "0"}], "&&", 
             RowBox[{"\[Beta]", ">=", "0"}], " ", "&&", " ", 
             RowBox[{"\[Gamma]", ">=", "0"}]}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"\[Alpha]", ",", "\[Beta]"}], "}"}], ",", " ", "Reals"}],
            " ", "]"}], " ", "//", " ", "Simplify"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"isstable", "==", "False"}], ",", "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
