          RowBox[{"2", " ", "\[Alpha]"}], 
          RowBox[{
           RowBox[{"4", " ", "\[Alpha]"}], "+", "\[Gamma]"}]]}], " ", "/.", 
        RowBox[{"\[Alpha]", "->", "0.02"}]}], ",", 
