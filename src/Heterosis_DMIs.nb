Cell[TextData[{
 "Let the haplotype frequencies of ab, aB, Ab, and AB be described by the \
vector ",
 StyleBox["x",
  FontWeight->"Bold"],
 " = {x1, x2, x3, x4}.  And linkage disequilibrium given by ",
 StyleBox["D",
  FontWeight->"Bold"],
 " = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["x", "1"], 
     SubscriptBox["x", "4"]}], "-", " ", 
    RowBox[{
     SubscriptBox["x", "2"], 
     SubscriptBox["x", "3"]}]}], TraditionalForm]],ExpressionUUID->
  "8ebe92c0-650b-414b-a17c-280f9bdaf403"],
 " "
}], "Text",
 CellChangeTimes->{{3.8922783636225157`*^9, 3.892278489546337*^9}, {
   3.8922785514767017`*^9, 3.892278577382321*^9}, {3.8926207422279577`*^9, 
   3.892620773195591*^9}, {3.893819766013546*^9, 3.893819802204607*^9}, 
   3.903759887066696*^9, {3.908512813947364*^9, 3.9085128726746492`*^9}, {
   3.972979302401773*^9, 
   3.972979310594122*^9}},ExpressionUUID->"188de2e6-0838-4e65-997b-\
a48504e7ba38"],

Cell[BoxData[{
 RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4"}], "}"}]}], " ", 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"DAB", " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"x", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "*", 
      RowBox[{"x", "[", 
       RowBox[{"[", "4", "]"}], "]"}]}], " ", "-", 
     RowBox[{
      RowBox[{"x", "[", 
       RowBox[{"[", "2", "]"}], "]"}], "*", 
      RowBox[{"x", "[", 
       RowBox[{"[", "3", "]"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"m", " ", "=", " ", 
     RowBox[{"m2", " ", "+", " ", "m3"}]}], ";"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Some", " ", "conversion", " ", "rules", " ", 
    RowBox[{"(", 
     RowBox[{"Haplotype", "->", "Allele"}], ")"}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"transferpRule", " ", "=", " ", 
   RowBox[{
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"pA", "\[Equal]", 
         RowBox[{"1", "-", "x1", "-", "x2"}]}], ",", 
        RowBox[{"pB", "\[Equal]", 
         RowBox[{"1", "-", "x1", "-", "x3"}]}], ",", 
        RowBox[{"ld", "==", 
         RowBox[{
          RowBox[{"x1", "*", 
           RowBox[{"(", 
            RowBox[{"1", "-", "x1", "-", "x2", "-", "x3"}], ")"}]}], "-", 
          RowBox[{"x2", "*", "x3"}]}]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"x1", ",", "x2", ",", "x3"}], "}"}]}], "]"}], "//", 
    "Flatten"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"alleletohaplo", "[", 
    RowBox[{"{", 
     RowBox[{"pA_", ",", "pB_", ",", "LD_"}], "}"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"1", "+", "LD", "-", "pA", "-", "pB", "+", 
       RowBox[{"pA", " ", "pB"}]}], ",", 
      RowBox[{
       RowBox[{"-", "LD"}], "+", "pB", "-", 
       RowBox[{"pA", " ", "pB"}]}], ",", 
      RowBox[{
       RowBox[{"-", "LD"}], "+", "pA", "-", 
       RowBox[{"pA", " ", "pB"}]}]}], "}"}], "//", "Simplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"haplotoallele", "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"1", "-", 
       RowBox[{"x", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "-", 
       RowBox[{"x", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ",", 
      RowBox[{"1", "-", 
       RowBox[{"x", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "-", 
       RowBox[{"x", "[", 
        RowBox[{"[", "3", "]"}], "]"}]}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"x", "[", 
         RowBox[{"[", "1", "]"}], "]"}], 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"x", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "-", 
          RowBox[{"x", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "-", 
          RowBox[{"x", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}], ")"}]}], "-", 
       RowBox[{
        RowBox[{"x", "[", 
         RowBox[{"[", "2", "]"}], "]"}], 
        RowBox[{"x", "[", 
         RowBox[{"[", "3", "]"}], "]"}]}]}]}], "}"}], "//", "Simplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"haplotogeno", "[", "x_", "]"}], ":=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"x", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "*", 
      RowBox[{"x", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ",", 
     RowBox[{"2", "*", 
      RowBox[{"x", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "*", 
      RowBox[{"x", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ",", 
     RowBox[{"2", "*", 
      RowBox[{"x", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "*", 
      RowBox[{"x", "[", 
       RowBox[{"[", "3", "]"}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"2", "*", 
       RowBox[{"x", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "*", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"x", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "-", 
         RowBox[{"x", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "-", 
         RowBox[{"x", "[", 
          RowBox[{"[", "3", "]"}], "]"}]}], ")"}]}], "+", 
      RowBox[{"2", "*", 
       RowBox[{"x", "[", 
        RowBox[{"[", "2", "]"}], "]"}], "*", 
       RowBox[{"x", "[", 
        RowBox[{"[", "3", "]"}], "]"}]}]}], ",", 
     RowBox[{
      RowBox[{"x", "[", 
       RowBox[{"[", "2", "]"}], "]"}], "*", 
      RowBox[{"x", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ",", 
     RowBox[{"2", "*", 
      RowBox[{"x", "[", 
       RowBox[{"[", "2", "]"}], "]"}], "*", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"x", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "-", 
        RowBox[{"x", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "-", 
        RowBox[{"x", "[", 
         RowBox[{"[", "3", "]"}], "]"}]}], ")"}]}], ",", 
     RowBox[{
      RowBox[{"x", "[", 
       RowBox[{"[", "3", "]"}], "]"}], "*", 
      RowBox[{"x", "[", 
       RowBox[{"[", "3", "]"}], "]"}]}], ",", 
     RowBox[{"2", "*", 
      RowBox[{"x", "[", 
       RowBox[{"[", "3", "]"}], "]"}], "*", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"x", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "-", 
        RowBox[{"x", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "-", 
        RowBox[{"x", "[", 
         RowBox[{"[", "3", "]"}], "]"}]}], ")"}]}], ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"x", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "-", 
        RowBox[{"x", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "-", 
        RowBox[{"x", "[", 
         RowBox[{"[", "3", "]"}], "]"}]}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"x", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "-", 
        RowBox[{"x", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "-", 
        RowBox[{"x", "[", 
         RowBox[{"[", "3", "]"}], "]"}]}], ")"}]}]}], "}"}]}], 
  ";"}]}], "Input",
