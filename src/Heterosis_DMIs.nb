            RowBox[{"ld", " ", "->", 
             RowBox[{"#", "[", 
              RowBox[{"[", "3", "]"}], "]"}]}]}], "}"}], "]"}], "]"}], " ", 
        "&"}], " ", "/@", " ", "ze"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"stableeq", " ", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"#", "[", 
