ebcbdd2ed594"],

Cell[TextData[{
 "First, let' s consider the cases for r = 0 and LE for codominant epistasis \
and weak migration\n(R = 0 -> ",
 Cell[BoxData[
  RowBox[{
   FractionBox["m", "\[Alpha]"], "+", 
   FractionBox[
    RowBox[{
     RowBox[{"8", " ", 
      SuperscriptBox["\[Alpha]", "2"]}], "-", 
     RowBox[{"2", " ", "\[Alpha]", " ", "\[Gamma]"}]}], 
    RowBox[{
     RowBox[{"16", " ", 
      SuperscriptBox["\[Alpha]", "2"]}], "-", 
     SuperscriptBox["\[Gamma]", "2"]}]]}]],ExpressionUUID->
  "0561196d-45cd-4283-a01d-160fdeac2d60"],
 ", LE case -> ",
 Cell[BoxData[
  RowBox[{
   FractionBox["\[Alpha]", 
    RowBox[{" ", 
     RowBox[{
      RowBox[{"2", "\[Alpha]"}], "+", "\[Gamma]"}]}]], "+", 
   FractionBox[
    RowBox[{
     RowBox[{"\[Gamma]", "/", "\[Alpha]"}], " ", "m"}], 
    RowBox[{"(", 
     RowBox[{"\[Alpha]", "+", "\[Gamma]"}], ")"}]]}]],ExpressionUUID->
  "2359c5e6-e1f9-497d-b900-cc7638d0b466"],
 ")"
}], "Text",
