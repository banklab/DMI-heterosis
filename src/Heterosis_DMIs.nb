Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"xdotsd", "[", 
     RowBox[{"{", 
      RowBox[{"A_", ",", "B_", ",", "C_", ",", "R_", ",", "M_"}], "}"}], 
     "]"}], "[", 
    RowBox[{"{", 
     RowBox[{"X1_", ",", "X2_", ",", "X3_", ",", " ", "X4_"}], "}"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"\[CapitalDelta]x", "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Alpha]", "\[Rule]", "A"}], ",", 
        RowBox[{"\[Beta]", "\[Rule]", "B"}], ",", 
        RowBox[{"r", "\[Rule]", "R"}], ",", 
        RowBox[{"x1", "\[Rule]", "X1"}], ",", 
        RowBox[{"x2", "\[Rule]", "X2"}], ",", 
        RowBox[{"x3", "\[Rule]", "X3"}], ",", " ", 
        RowBox[{"x4", "->", "X4"}]}], "}"}]}], "/.", 
     RowBox[{"Thread", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "\[Gamma]1", ",", "\[Gamma]2", ",", "\[Gamma]3", ",", "\[Gamma]4"}], 
        "}"}], "\[Rule]", "C"}], "  ", "]"}]}], "/.", 
    RowBox[{"Thread", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"m2", ",", "m3"}], "}"}], "\[Rule]", "M"}], " ", "]"}]}]}], 
  ";"}]], "Input",
