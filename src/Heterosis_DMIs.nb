        FractionBox[
         RowBox[{
           RowBox[{"(", 
             RowBox[{"1", "-", 
               StyleBox["m", "TI"]}], ")"}], "(", 
           RowBox[{
             SubscriptBox[
              StyleBox["x", "TI"], "2"], 
             SubscriptBox[
              StyleBox["w", "TI"], "2"], "+", 
             StyleBox["r", "TI"], 
             SubscriptBox[
              StyleBox["w", "TI"], "14"], 
