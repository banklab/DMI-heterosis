         OverscriptBox[
          StyleBox["w", "TI"], "_"]], "+", 
        StyleBox["m", "TI"], "3", "\\[NewLine]", 
        SubsuperscriptBox[
         StyleBox["x", "TI"], "4", "\[Prime]"], "\[LongEqual]", 
        FractionBox[
         RowBox[{
