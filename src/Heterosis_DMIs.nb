Cell[BoxData[
 RowBox[{
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"i", "=", "1"}], ",", 
    RowBox[{"i", "<=", 
     RowBox[{"Length", "[", "solsLE", "]"}]}], ",", 
    RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"isreal", " ", "=", " ", 
      RowBox[{"Reduce", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"solsLE", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "2"}], "]"}], "]"}], " ", "\[Element]", " ", 
          "Reals"}], " ", "&&", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"solsLE", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"2", ",", "2"}], "]"}], "]"}], " ", "\[Element]", " ", 
          "Reals"}], " ", "&&", " ", 
         RowBox[{"\[Gamma]", ">=", "0"}], " ", "&&", " ", 
         RowBox[{"\[Alpha]", ">=", "0"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"\[Alpha]", ",", "\[Gamma]"}], "}"}], ",", " ", "Reals"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"isreal", "!=", "False"}], ",", ",", ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"ei", " ", "=", " ", 
         RowBox[{
          RowBox[{"Eigenvalues", "[", 
           RowBox[{
            RowBox[{"Jacp", "[", 
             RowBox[{"{", 
              RowBox[{
              "\[Alpha]", ",", "\[Beta]", ",", "\[CapitalGamma]x", ",", "LE", 
               ",", "M"}], "}"}], "]"}], "[", 
            RowBox[{"solsLE", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], " ", "//", " ", 
          "Simplify"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
           "Check", " ", "if", " ", "eigenvalue", " ", "is", " ", "stable"}], 
           ",", " ", 
           RowBox[{
            RowBox[{"i", ".", "e", ".", " ", "real"}], " ", "and", " ", 
            "negative"}]}], ")"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"isstable", " ", "=", 
         RowBox[{
          RowBox[{"Reduce", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"ei", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "<", "0"}], " ", "&&", " ", 
             RowBox[{
              RowBox[{"ei", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "<", "0"}], " ", "&&", " ", 
             RowBox[{"\[Alpha]", ">=", "0"}], "&&", 
             RowBox[{"\[Beta]", ">=", "0"}]}], " ", ",", " ", 
            RowBox[{"{", 
             RowBox[{"\[Alpha]", ",", "\[Beta]"}], "}"}], ",", " ", "Reals"}],
            " ", "]"}], " ", "//", " ", "Simplify"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"isstable", "==", "False"}], ",", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"Print", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"solsLE", "[", 
               RowBox[{"[", "i", "]"}], "]"}], " ", "//", " ", "Simplify"}], 
             ",", "\"\<\\t Unstable\>\""}], "]"}], "*)"}], 
          RowBox[{
           RowBox[{"Print", "[", "\"\<\>\"", "]"}], ";"}], ",", 
          RowBox[{"Print", "[", "0", "]"}], ",", 
          RowBox[{
           RowBox[{"Print", "[", 
            RowBox[{
             RowBox[{"solsLE", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", "\"\<\\t Stable (i=\>\"", 
             ",", "i", ",", "\"\<) \\n\>\"", ",", " ", 
             RowBox[{"Style", "[", 
              RowBox[{
               RowBox[{"Reduce", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"1", ">=", 
                   RowBox[{
                    RowBox[{"solsLE", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}], ">=", "0"}], " ", "&&", 
                  RowBox[{"1", ">=", 
                   RowBox[{
                    RowBox[{"solsLE", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"2", ",", "2"}], "]"}], "]"}], ">=", "0"}], " ", 
                  " ", "&&", 
                  RowBox[{"\[Alpha]", ">=", "0"}], "&&", 
                  RowBox[{"\[Beta]", ">=", "0"}], " ", "&&", " ", 
                  RowBox[{"mi", ">", "0"}]}], ",", " ", 
                 RowBox[{"{", 
                  RowBox[{"\[Alpha]", ",", "\[Beta]"}], "}"}], ",", "Reals"}],
                 "]"}], ",", "Bold"}], "]"}]}], "]"}], ";"}]}], 
         "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
     ";"}]}], "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]"}]], "Input",\

