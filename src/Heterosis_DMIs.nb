Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "Stability", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"i", "=", "1"}], ",", 
    RowBox[{"i", "<=", 
     RowBox[{"Length", "[", "solsLE", "]"}]}], ",", 
    RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"isreal", " ", "=", " ", 
      RowBox[{"Reduce", "[", 
