            RowBox[{"sols", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], " ", "//", " ", 
          "Simplify"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
