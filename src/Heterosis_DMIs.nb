            RowBox[{"Jacp", "[", 
             RowBox[{"{", 
              RowBox[{
              "\[Alpha]", ",", "\[Alpha]", ",", "\[CapitalGamma]x", ",", "LE",
                ",", "M"}], "}"}], "]"}], "[", 
            RowBox[{"solsLE", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], " ", "//", " ", 
          "Simplify"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
           "Check", " ", "if", " ", "eigenvalue", " ", "is", " ", "stable"}], 
           ",", " ", 
           RowBox[{
            RowBox[{"i", ".", "e", ".", " ", "real"}], " ", "and", " ", 
            "negative"}]}], ")"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"isstable", " ", "=", 
