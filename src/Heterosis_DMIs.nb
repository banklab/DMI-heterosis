Cell[TextData[{
 "Where ",
 StyleBox["r",
  FontWeight->"Bold"],
 " is the recombination rate, ",
 StyleBox["DAB ",
  FontWeight->"Bold"],
 "is the linkage disequilibrium, ",
 StyleBox["m",
  FontWeight->"Bold"],
 " is the migration rate, which is the sum of ",
 StyleBox["m2",
  FontWeight->"Bold"],
 " (migration from parental haplotype ",
 StyleBox["aB",
  FontWeight->"Bold"],
 ")",
 StyleBox[" ",
  FontWeight->"Bold"],
 "and",
 StyleBox[" m3 ",
  FontWeight->"Bold"],
 "(migration from parental haplotype",
 StyleBox[" Ab",
  FontWeight->"Bold"],
 ")."
}], "Text",
 CellChangeTimes->{
  3.892282828287599*^9, {3.892282942650743*^9, 3.8922829434103003`*^9}, 
   3.892621147582386*^9, {3.892696051283662*^9, 3.8926960708759403`*^9}, {
   3.892701015200219*^9, 3.892701134240485*^9}, {3.89288641406326*^9, 
   3.8928864142077723`*^9}},ExpressionUUID->"5c29a50a-b8fd-41b9-ac57-\
e13e968e7be7"],

Cell["\<\
And allele frequencies and LD dynamics can be expressed as :
{dA/dt, dB/dt, dD/dt}\
\>", "Text",
 CellChangeTimes->{{3.8922871806562757`*^9, 3.892287246914386*^9}, 
